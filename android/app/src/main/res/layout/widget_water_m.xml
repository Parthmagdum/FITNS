<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
        android:id="@+id/wa_glass"
        android:layout_width="46dp"
        android:layout_height="70dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/wpreview_glass"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
        android:id="@+id/wa_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Water"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"/>
            <TextView
        android:id="@+id/wa_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="1.2 L"
        android:textColor="@color/widget_text"
        android:textSize="24sp"
        android:layout_marginTop="2dp"/>
            <TextView
        android:id="@+id/wa_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="/2 L"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
        android:id="@+id/wa_add1"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_weight="1"
        android:background="@drawable/widget_water_button"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:text="+250 ml"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"/>
        <TextView
        android:id="@+id/wa_add2"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_pill_button"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:text="+500 ml"
        android:textColor="@color/widget_water"
        android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
