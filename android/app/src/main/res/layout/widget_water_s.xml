<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_pill"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">
    <ImageView
        android:id="@+id/wa_glass"
        android:layout_width="32dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/wpreview_glass"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
        android:id="@+id/wa_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="1.2 L"
        android:textColor="@color/widget_text"
        android:textSize="18sp"/>
        <TextView
        android:id="@+id/wa_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="/2 L"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:layout_marginTop="2dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/wa_add1"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_water_button">
        <ImageView
        android:id="@+id/wa_add_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_add"
        android:layout_gravity="center"/>
    </FrameLayout>
</LinearLayout>
