<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/st_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:padding="10dp">
    <FrameLayout
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:layout_gravity="center">
        <ImageView
        android:id="@+id/st_ring"
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/wpreview_ring_kcal"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
        android:id="@+id/st_chip"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_chip_burn"/>
            <TextView
        android:id="@+id/st_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="312"
        android:textColor="@color/widget_text"
        android:textSize="22sp"
        android:layout_marginTop="4dp"/>
            <TextView
        android:id="@+id/st_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="/540 kcal"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:layout_marginTop="2dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
