<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/wo_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/wpreview_contours"/>
    <ImageView
        android:id="@+id/wo_mark"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_mark"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
        android:id="@+id/wo_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="2/4 this week"
        android:textColor="@color/widget_text"
        android:textSize="13sp"/>
        <ImageView
        android:id="@+id/wo_dashes"
        android:layout_width="150dp"
        android:layout_height="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/wpreview_dashes"
        android:layout_marginTop="8dp"
        android:scaleType="fitXY"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
        android:id="@+id/wo_kind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Training day"
        android:textColor="@color/widget_accent"
        android:textSize="14sp"/>
                <TextView
        android:id="@+id/wo_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Push day"
        android:textColor="@color/widget_text"
        android:textSize="22sp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"/>
                <TextView
        android:id="@+id/wo_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="6 exercises · ~30 min"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:layout_marginTop="3dp"/>
            </LinearLayout>
            <TextView
        android:id="@+id/wo_start"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/widget_start_button"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:text="▶  Start"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
