<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/act_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_pill"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">
    <ImageView
        android:id="@+id/act_rings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/wpreview_rings"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
        <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
        android:id="@+id/act_chip1"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_chip_steps"/>
        <TextView
        android:id="@+id/act_val1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="5,240"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:layout_marginStart="6dp"/>
    </LinearLayout>
        <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
        android:id="@+id/act_chip2"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_chip_water"/>
        <TextView
        android:id="@+id/act_val2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="1.2 L"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:layout_marginStart="6dp"/>
    </LinearLayout>
        <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
        android:id="@+id/act_chip3"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_chip_kcal"/>
        <TextView
        android:id="@+id/act_val3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="960"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:layout_marginStart="6dp"/>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
