<?xml version="1.0" encoding="utf-8"?>
<!-- The small streak widget (StreakWidget.kt): weeks in a row with a
     workout. Updated by FITNS whenever the numbers change. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/streak_widget"
    android:previewLayout="@layout/streak_widget"
    android:description="@string/streak_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"/>
