<?xml version="1.0" encoding="utf-8"?>
<!-- A round badge: gradient disc, white icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#FF5EEAD4" android:endColor="#FF6366F1"/>
        </shape>
    </item>
    <item android:drawable="@drawable/ic_w_weight" android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp"/>
</layer-list>
