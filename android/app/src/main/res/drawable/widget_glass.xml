<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass: a translucent gradient with a light rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270"
        android:startColor="@color/widget_glass_top"
        android:endColor="@color/widget_glass_bottom"/>
    <stroke android:width="1dp" android:color="@color/widget_glass_rim"/>
    <corners android:radius="28dp"/>
</shape>
